{% if page.url != "/" %}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Global Engagement</a></li>
    {% if breadcrumbs %}
      {% for b in breadcrumbs %}<li><a href="{{ b.url }}">{{ b.label }}</a></li>{% endfor %}
    {% endif %}
    <li aria-current="page">{{ title }}</li>
  </ol>
</nav>
{% endif %}
