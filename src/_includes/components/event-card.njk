{# Expects `event` from eventsSorted.upcoming / .past #}
<article class="event-card {% if event.past %}event-card--past{% endif %}">
  <div class="event-card__date" aria-hidden="true">
    <span class="event-card__month">{{ event.start | date("LLL") }}</span>
    <span class="event-card__day">{{ event.start | date("d") }}</span>
  </div>
  <div class="event-card__body">
    <p class="event-card__type">{{ event.type }}{% if event.region %} · {{ event.region }}{% endif %}</p>
    <h3 class="event-card__title"><a href="{{ event.url or '/events/#' + event.id }}">{{ event.title }}</a></h3>
    <p class="event-card__when">
      <time datetime="{{ event.start }}">{{ event.start | date("cccc, LLLL d, yyyy") }}{% if event.time %} · {{ event.time }}{% endif %}</time>
      {% if event.end and event.end != event.start %} – <time datetime="{{ event.end }}">{{ event.end | date("LLLL d, yyyy") }}</time>{% endif %}
    </p>
    {% if event.location %}<p class="event-card__where">{{ event.location }}</p>{% endif %}
  </div>
</article>
