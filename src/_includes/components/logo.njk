    <ellipse cx="22" cy="22" rx="9" ry="20" fill="none" stroke="currentColor" stroke-width="1.6"/>
    <path d="M2 22h40M5.5 12h33M5.5 32h33" fill="none" stroke="currentColor" stroke-width="1.6"/>
    <path d="M22 15.2l1.9 4.1 4.5.5-3.3 3.1.9 4.5L22 25.2l-4 2.2.9-4.5-3.3-3.1 4.5-.5z" fill="#bf5700"/>
